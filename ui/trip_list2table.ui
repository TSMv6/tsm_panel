     <item>
      <widget class="QGroupBox" name="groupBox_ExtCal">
       <property name="title">
        <string>External station calibration (I-10 / I-75 / I-95)</string>
       </property>
       <property name="toolTip">
        <string>agentPlans scales LDT trips through each external station so the station total matches its count. The targets file is written into the scenario directory by this dialog immediately before the run.</string>
       </property>
       <layout class="QVBoxLayout" name="extCalLayout">
        <item>
         <widget class="QCheckBox" name="checkBox_extCalib">
          <property name="text">
           <string>Calibrate external stations to counts (I-10 / I-75 / I-95)</string>
          </property>
          <property name="toolTip">
           <string>ON: write ldt_external_targets.csv and scale LDT trips through each external station so the station total matches its target (apply_external_targets=true).  OFF: no external scaling at all -- the LDT model's own volumes stand.</string>
          </property>
         </widget>
        </item>
        <item>
         <layout class="QHBoxLayout" name="extModeLayout">
          <item>
           <widget class="QRadioButton" name="radio_extBase">
            <property name="text">
             <string>Base-year target (use the count as-is)</string>
            </property>
            <property name="toolTip">
             <string>Target = Base Count exactly. Written as an absolute number, so no growth is applied whatever the scenario year.</string>
            </property>
            <property name="checked">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QRadioButton" name="radio_extGrow">
            <property name="text">
             <string>Grow to scenario year (linear %/yr)</string>
            </property>
            <property name="toolTip">
             <string>Target = Base Count x (1 + rate/100 x (scenario year - base year)). LINEAR, not compound: 1.0%/yr over 31 years is x1.31, not x1.36.</string>
            </property>
           </widget>
          </item>
          <item>
           <spacer name="extModeSpacer">
            <property name="orientation">
