                 <widget class="QWidget" name="page_MM_Tags">
                  <attribute name="title">
                   <string>Tiers and probes</string>
                  </attribute>
                  <layout class="QVBoxLayout" name="page_MM_TagsLayout">
                  <item>
                   <widget class="QGroupBox" name="groupBox_Tags">
                    <layout class="QVBoxLayout" name="vLayout_tags">
                     <item>
                      <widget class="QLabel" name="label_TagCounts">
                       <property name="text">
                        <string></string>
                       </property>
                       <property name="wordWrap">
                        <bool>true</bool>
                       </property>
                      </widget>
                     </item>
                     <item>
                      <widget class="QTabWidget" name="tabWidget_Tags">
                       <widget class="QWidget" name="page_TagMeso">
                        <attribute name="title">
                         <string>Meso</string>
                        </attribute>
                        <layout class="QGridLayout" name="gridLayout_tagmeso">
                         <item row="0" column="0">
                          <widget class="QPushButton" name="btn_TagMesoSel">
                           <property name="text">
                            <string>Set from selection</string>
                           </property>
                           <property name="toolTip">
                            <string>Set dta_meso = 1 on the links selected in the HyDRA link layer.</string>
                           </property>
                          </widget>
                         </item>
                         <item row="0" column="1">
                          <widget class="QPushButton" name="btn_TagMesoExpr">
                           <property name="text">
                            <string>Set by expression…</string>
                           </property>
                           <property name="toolTip">
                            <string>Set dta_meso = 1 on every link matching a QGIS expression, e.g. "FTYPE" IN (11, 12).</string>
                           </property>
                          </widget>
                         </item>
                         <item row="0" column="2">
                          <widget class="QPushButton" name="btn_TagMesoClear">
                           <property name="text">
                            <string>Clear</string>
                           </property>
                           <property name="toolTip">
                            <string>Set dta_meso = 0 on every link.</string>
                           </property>
                          </widget>
                         </item>
                        </layout>
                       </widget>
                       <widget class="QWidget" name="page_TagMicro">
                        <attribute name="title">
                         <string>Micro</string>
                        </attribute>
                        <layout class="QGridLayout" name="gridLayout_tagmicro">
                         <item row="0" column="0">
                          <widget class="QPushButton" name="btn_TagMicroSel">
                           <property name="text">
                            <string>Set from selection</string>
                           </property>
                           <property name="toolTip">
                            <string>Set dta_micro = 1 on the links selected in the HyDRA link layer.</string>
                           </property>
                          </widget>
                         </item>
                         <item row="0" column="1">
                          <widget class="QPushButton" name="btn_TagMicroExpr">
                           <property name="text">
                            <string>Set by expression…</string>
                           </property>
                           <property name="toolTip">
                            <string>Set dta_micro = 1 on every link matching a QGIS expression, e.g. "FTYPE" IN (11, 12).</string>
                           </property>
                          </widget>
                         </item>
                         <item row="0" column="2">
                          <widget class="QPushButton" name="btn_TagMicroClear">
                           <property name="text">
                            <string>Clear</string>
                           </property>
                           <property name="toolTip">
                            <string>Set dta_micro = 0 on every link.</string>
                           </property>
                          </widget>
                         </item>
                         <item row="2" column="0">
                          <widget class="QLabel" name="label_MicroArea">
                           <property name="text">
                            <string>Micro area (polygon)</string>
                           </property>
                          </widget>
                         </item>
                         <item row="2" column="1" colspan="2">
                          <widget class="QComboBox" name="comboBox_MicroArea">
                           <property name="toolTip">
                            <string>Network micro: a polygon layer; every HyDRA link inside its (selected, else all) polygons joins the micro area (MICRO_AREA_LINKS). Nothing is written to the link layer.</string>
                           </property>
                          </widget>
                         </item>
                         <item row="3" column="0" colspan="3">
                          <widget class="QCheckBox" name="checkBox_MicroCross">
                           <property name="text">
                            <string>Add the cross-street approaches of every intersection</string>
                           </property>
                           <property name="checked">
                            <bool>true</bool>
                           </property>
                           <property name="toolTip">
                            <string>MICRO_CROSS_STREETS -- one link deep on every leg, so turning and crossing traffic is simulated (network micro).</string>
                           </property>
                          </widget>
                         </item>
                        </layout>
                       </widget>
                       <widget class="QWidget" name="page_TagProbe">
                        <attribute name="title">
                         <string>Probe links</string>
                        </attribute>
                        <layout class="QGridLayout" name="gridLayout_tagprobe">
                         <item row="0" column="0">
                          <widget class="QPushButton" name="btn_TagProbeSel">
                           <property name="text">
                            <string>Set from selection</string>
                           </property>
                           <property name="toolTip">
                            <string>Set probe = 1 on the links selected in the HyDRA link layer.</string>
                           </property>
                          </widget>
                         </item>
                         <item row="0" column="1">
                          <widget class="QPushButton" name="btn_TagProbeExpr">
                           <property name="text">
                            <string>Set by expression…</string>
                           </property>
                           <property name="toolTip">
                            <string>Set probe = 1 on every link matching a QGIS expression, e.g. "FTYPE" IN (11, 12).</string>
                           </property>
                          </widget>
                         </item>
                         <item row="0" column="2">
                          <widget class="QPushButton" name="btn_TagProbeClear">
                           <property name="text">
                            <string>Clear</string>
                           </property>
                           <property name="toolTip">
                            <string>Set probe = 0 on every link.</string>
                           </property>
                          </widget>
                         </item>
                        </layout>
                       </widget>
                       <widget class="QWidget" name="page_TagNodeProbe">
                        <attribute name="title">
                         <string>Probe nodes</string>
                        </attribute>
                        <layout class="QGridLayout" name="gridLayout_tagnodeprobe">
                         <item row="0" column="0">
                          <widget class="QPushButton" name="btn_TagNodeProbeSel">
                           <property name="text">
                            <string>Set from selection</string>
                           </property>
                           <property name="toolTip">
                            <string>Set probe = 1 on the nodes selected in the HyDRA node layer.</string>
                           </property>
                          </widget>
                         </item>
                         <item row="0" column="1">
                          <widget class="QPushButton" name="btn_TagNodeProbeExpr">
                           <property name="text">
                            <string>Set by expression…</string>
                           </property>
                           <property name="toolTip">
                            <string>Set probe = 1 on every node matching a QGIS expression, e.g. "FTYPE" IN (11, 12).</string>
                           </property>
                          </widget>
                         </item>
                         <item row="0" column="2">
                          <widget class="QPushButton" name="btn_TagNodeProbeClear">
                           <property name="text">
                            <string>Clear</string>
                           </property>
                           <property name="toolTip">
                            <string>Set probe = 0 on every node.</string>
                           </property>
                          </widget>
                         </item>
                        </layout>
                       </widget>
                      </widget>
                     </item>
                    </layout>
                   </widget>
                  </item>
                   <item>
                    <spacer name="page_MM_TagsSpacer">
                     <property name="orientation">
                      <enum>Qt::Vertical</enum>
                     </property>
                     <property name="sizeHint" stdset="0">
                      <size>
                       <width>20</width>
                       <height>5</height>
                      </size>
                     </property>
                    </spacer>
                   </item>
                  </layout>
                 </widget>
                 <widget class="QWidget" name="page_MM_Gmns">
                  <attribute name="title">
                   <string>GMNS</string>
                  </attribute>
                  <layout class="QVBoxLayout" name="page_MM_GmnsLayout">
                   <item>
                    <widget class="QGroupBox" name="groupBox_Gmns">
                     <property name="title">
                      <string>Lanes, pockets, movements, signal timing</string>
                     </property>
                     <layout class="QVBoxLayout" name="vLayout_gmns">
                      <item>
                       <layout class="QHBoxLayout" name="hLayout_gmnsFile">
                        <item>
                         <widget class="QLabel" name="label_GmnsFile">
                          <property name="text">
                           <string>GMNS package</string>
                          </property>
                         </widget>
                        </item>
                        <item>
                         <widget class="QLineEdit" name="lineEdit_GmnsFile">
                          <property name="toolTip">
                           <string>gmns_network.gpkg written by netPrep beside Link.csv (gmns_network_msr.gpkg for an MSR network).</string>
                          </property>
                         </widget>
                        </item>
                        <item>
                         <widget class="QToolButton" name="browse_GmnsFile">
                          <property name="text">
                           <string>...</string>
                          </property>
                         </widget>
                        </item>
                       </layout>
                      </item>
                      <item>
                       <layout class="QHBoxLayout" name="hLayout_gmnsButtons">
                        <item>
                         <widget class="QPushButton" name="btn_GmnsLoad">
                          <property name="text">
                           <string>Load layers</string>
                          </property>
                          <property name="toolTip">
                           <string>Add the GMNS layers to the map, styled, with forms linking link -&gt; lanes / pockets, node -&gt; movements and timing plan -&gt; phases -&gt; movements.</string>
                          </property>
                         </widget>
                        </item>
                        <item>
                         <widget class="QPushButton" name="btn_GmnsSignals">
                          <property name="text">
                           <string>Signal timing...</string>
                          </property>
                          <property name="toolTip">
                           <string>Edit the timing plan of a signalized node: cycle, phases (ring, barrier, greens, clearance) and which movements each phase serves.</string>
                          </property>
                         </widget>
                        </item>
                        <item>
                         <widget class="QPushButton" name="btn_GmnsValidate">
                          <property name="text">
                           <string>Validate...</string>
                          </property>
                          <property name="toolTip">
                           <string>Check the package: timing plans sum to the cycle, every signal movement is in a phase, lanes and pockets are in range. Also fills in missing pocket geometry.</string>
                          </property>
                         </widget>
                        </item>
                        <item>
                         <widget class="QPushButton" name="btn_GmnsImport">
                          <property name="text">
                           <string>Import timing pack...</string>
                          </property>
                          <property name="toolTip">
                           <string>Load signal timing plans from a timing pack folder (signal_timing_plan / signal_timing_phase / signal_phase_mvmt CSVs, movements keyed by node, from node and to node). Replaces the timing of every node a pack controller drives. Samples: config/gmns/samples.</string>
                          </property>
                         </widget>
                        </item>
                       </layout>
                      </item>
                      <item>
                       <widget class="QCheckBox" name="checkBox_UseGmns">
                        <property name="text">
                         <string>Use GMNS in the run</string>
                        </property>
                        <property name="toolTip">
                         <string>GMNS_DIR -- the layers are exported to &lt;output&gt;/gmns at run time. Timing plans set each timed approach's g/C and cycle in the macro / meso signal model, statewide (Signal delay on the Engine tab must be on; never in a static run); lane allowed_uses restrict trucks in the micro corridor. This does not run micro: micro runs only on the micro area (Tiers and probes), and a network micro run always uses the package.</string>
                        </property>
                       </widget>
                      </item>
                     </layout>
                    </widget>
                   </item>
                   <item>
                    <spacer name="page_MM_GmnsSpacer">
                     <property name="orientation">
                      <enum>Qt::Vertical</enum>
                     </property>
                     <property name="sizeHint" stdset="0">
                      <size>
                       <width>20</width>
                       <height>5</height>
                      </size>
                     </property>
                    </spacer>
                   </item>
                  </layout>
                 </widget>
               </widget>
              </item>
             </layout>
            </widget>
            <widget class="QWidget" name="page_DTA_Advanced">
             <attribute name="title">
              <string>Advanced (afdta)</string>
             </attribute>
             <layout class="QVBoxLayout" name="page_DTA_AdvancedLayout">
              <item>
               <widget class="QGroupBox" name="groupBox_Advanced">
                <property name="title">
                 <string>Advanced (afdta) — rerouting, LTM, sampling</string>
                </property>
                <layout class="QGridLayout" name="gridLayout_adv">
                 <item row="0" column="0">
                  <widget class="QLabel" name="label_rerouteFrac">
                   <property name="text">
                    <string>Reroute fraction (min)</string>
                   </property>
                  </widget>
                 </item>
                 <item row="0" column="1">
                  <widget class="QLineEdit" name="lineEdit_RerouteFraction">
                   <property name="text">
                    <string>0.05</string>
                   </property>
                   <property name="toolTip">
                    <string>REROUTE_FRACTION_MIN — the floor on how much demand may change path in one iteration. The share allowed is max(2/(n+1), this value): 100% at iteration 0, 67% at 1, 50% at 2 ... down to this floor, given to the route keys with the largest gaps first. Higher = faster but noisier; lower = smoother but slower to correct the last oscillations.</string>
                   </property>
                  </widget>
                 </item>
                 <item row="0" column="2">
                  <widget class="QLabel" name="label_rerouteThr">
                   <property name="text">
                    <string>Reroute threshold (min)</string>
                   </property>
                  </widget>
                 </item>
                 <item row="0" column="3">
                  <widget class="QLineEdit" name="lineEdit_RerouteThreshold">
                   <property name="text">
                    <string>0.01</string>
                   </property>
                   <property name="toolTip">
                    <string>REROUTE_THRESHOLD_MIN — a route key only adopts its new shortest path when that path beats its current one by more than this many minutes of generalized cost. Keys within the threshold count as stable (the stable % in the log). Stops paths from flipping between near-identical routes.</string>
                   </property>
                  </widget>
                 </item>
                 <item row="1" column="0">
                  <widget class="QLabel" name="label_spillback">
                   <property name="text">
                    <string>LTM max spillback (min)</string>
                   </property>
                  </widget>
                 </item>
                 <item row="1" column="1">
                  <widget class="QLineEdit" name="lineEdit_LtmSpillback">
                   <property name="text">
                    <string>20</string>
                   </property>
                   <property name="toolTip">
                    <string>LTM_MAX_SPILLBACK_MIN — cap on queue spillback propagation (minutes). LTM macro only.</string>
                   </property>
                  </widget>
                 </item>
                 <item row="1" column="2">
                  <widget class="QLabel" name="label_jam">
                   <property name="text">
                    <string>Jam density</string>
                   </property>
                  </widget>
                 </item>
                 <item row="1" column="3">
                  <widget class="QLineEdit" name="lineEdit_JamDensity">
                   <property name="text">
                    <string>240</string>
                   </property>
                   <property name="toolTip">
                    <string>JAM_DENSITY — veh/mi/lane at jam (LTM).</string>
                   </property>
                  </widget>
                 </item>
                 <item row="2" column="0">
                  <widget class="QLabel" name="label_maxtrips">
                   <property name="text">
                    <string>Max trips (0=all)</string>
                   </property>
                  </widget>
                 </item>
                 <item row="2" column="1">
                  <widget class="QLineEdit" name="lineEdit_MaxTrips">
                   <property name="text">
                    <string>0</string>
                   </property>
                   <property name="toolTip">
                    <string>MAX_TRIPS — cap trips loaded (0 = all). Use for quick test runs.</string>
                   </property>
                  </widget>
                 </item>
                 <item row="2" column="2">
                  <widget class="QLabel" name="label_sample">
                   <property name="text">
                    <string>Sample every</string>
                   </property>
                  </widget>
                 </item>
                 <item row="2" column="3">
                  <widget class="QLineEdit" name="lineEdit_SampleEvery">
                   <property name="text">
                    <string>1</string>
                   </property>
                   <property name="toolTip">
                    <string>SAMPLE_EVERY — load every Nth trip (1 = all).</string>
                   </property>
                  </widget>
                 </item>
                 <item row="3" column="0">
                  <widget class="QLabel" name="label_sampleSched">
                   <property name="text">
                    <string>Sampling schedule</string>
                   </property>
                  </widget>
                 </item>
                 <item row="3" column="1">
                  <widget class="QComboBox" name="comboBox_SampleSchedule">
                   <property name="toolTip">
                    <string>SAMPLE_SCHEDULE — coarse-to-fine sampling. Progressive runs the early iterations on a 25% then 50% sample and only the later ones at full sample, cutting wall time roughly 30% for the same converged result (each refinement causes a 1-2 iteration gap spike that damps). Full sample runs every iteration at 100%.</string>
                   </property>
                   <item>
                    <property name="text">
                     <string>Progressive (25 -&gt; 50 -&gt; 100%)</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>Full sample every iteration</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>Custom</string>
                    </property>
                   </item>
                  </widget>
                 </item>
                 <item row="3" column="2">
                  <widget class="QLabel" name="label_sampleCustom">
                   <property name="text">
                    <string>Custom schedule</string>
                   </property>
                  </widget>
                 </item>
                 <item row="3" column="3">
                  <widget class="QLineEdit" name="lineEdit_SampleSchedule">
                   <property name="placeholderText">
                    <string>1-4:25, 5-8:50, 9-15:100</string>
                   </property>
                   <property name="toolTip">
                    <string>Used only when Sampling schedule = Custom. Format: FROM-TO:PERCENT, comma separated.</string>
                   </property>
                  </widget>
                 </item>
                 <item row="4" column="0">
                  <widget class="QLabel" name="label_injectRes">
                   <property name="text">
                    <string>Loading resolution (min)</string>
                   </property>
                  </widget>
                 </item>
                 <item row="4" column="1">
                  <widget class="QSpinBox" name="spinBox_InjectRes">
                   <property name="minimum">
                    <number>1</number>
                   </property>
                   <property name="maximum">
                    <number>15</number>
                   </property>
                   <property name="value">
                    <number>15</number>
                   </property>
                   <property name="suffix">
                    <string> min</string>
                   </property>
                   <property name="toolTip">
                    <string>NODE_INJECT_RES — how finely a departure slot's trips are released onto the network by the node loaders (Node + PointQueue, Node + Spatial/LTM). 15 = one release per 15-min interval; 1 = minute by minute, which smooths the loading and avoids artificial queues at the start of each slot. Travel times still update every 15 minutes. Ignored by the per-link PointQueue mode.</string>
                   </property>
                  </widget>
                 </item>
                 <item row="4" column="2">
                  <widget class="QLabel" name="label_departSlot">
                   <property name="text">
                    <string>Departure slots</string>
                   </property>
                  </widget>
                 </item>
                 <item row="4" column="3">
                  <widget class="QComboBox" name="comboBox_DepartSlot">
                   <property name="toolTip">
                    <string>DEPART_SLOT_MIN — width of the departure slot in the route key (O · D · slot · marketVot) for a trip list with HH:MM:SS departure times. Auto follows the trip list's own grid: a 15-min agentPlans output gets 15-min keys, a 30-min output 30-min keys. A slot finer than the trip list loads each period's trips into its first part, so leave this on Auto unless testing.</string>
                   </property>
                   <item>
                    <property name="text">
                     <string>Auto (match trip list)</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>15 min</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>30 min</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>60 min</string>
                    </property>
                   </item>
                  </widget>
                 </item>
                 <item row="5" column="0" rowspan="1" colspan="1">
                  <widget class="QLabel" name="label_loadRefresh">
                   <property name="text">
                    <string>Per-link load refresh</string>
                   </property>
                  </widget>
                 </item>
                 <item row="5" column="1" rowspan="1" colspan="1">
                  <widget class="QComboBox" name="comboBox_LoadRefresh">
                   <property name="toolTip">
                    <string>LOAD_REFRESH — PointQueue (legacy per-link) run mode only. How the per-link loader refreshes between route chunks: Exact rebuilds every key's arrivals; Incremental updates only the keys that re-routed (faster, an approximation). This is NOT the node balancer: the node loaders use Node refresh (NODE_SCHEDULE) on the Engine and equilibrium tab.</string>
                   </property>
                   <property name="currentIndex">
                    <number>0</number>
                   </property>
                   <item>
                    <property name="text">
                     <string>Exact (rebuild all)</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>Incremental (delta)</string>
                    </property>
                   </item>
                  </widget>
                 </item>
                 <item row="5" column="2" rowspan="1" colspan="1">
                  <widget class="QLabel" name="label_loadSchedule">
                   <property name="text">
                    <string>Per-link load schedule</string>
                   </property>
                  </widget>
                 </item>
                 <item row="5" column="3" rowspan="1" colspan="1">
                  <widget class="QLineEdit" name="lineEdit_LoadSchedule">
                   <property name="placeholderText">
                    <string>(blank = every chunk)</string>
                   </property>
                   <property name="toolTip">
                    <string>LOAD_SCHEDULE — PointQueue (legacy per-link) run mode only. Refresh stride of the per-link loader, the same syntax as Node refresh: e.g. 1-9:iter, 10-15:chunk. Blank = after every chunk.</string>
                   </property>
                  </widget>
                 </item>
                </layout>
               </widget>
              </item>
              <item>
               <spacer name="page_DTA_AdvancedSpacer">
                <property name="orientation">
                 <enum>Qt::Vertical</enum>
                </property>
                <property name="sizeHint" stdset="0">
                 <size>
                  <width>20</width>
                  <height>5</height>
                 </size>
                </property>
               </spacer>
              </item>
             </layout>
            </widget>
            <widget class="QWidget" name="page_DTA_Checkpoint">
             <attribute name="title">
              <string>Checkpoint</string>
             </attribute>
             <layout class="QVBoxLayout" name="page_DTA_CheckpointLayout">
              <item>
               <widget class="QGroupBox" name="groupBox_CkptWrite">
                <property name="title">
                 <string>Write</string>
                </property>
                <layout class="QGridLayout" name="gridLayout_ckptw" columnstretch="0,0,0,1">
                 <item row="0" column="0" colspan="2">
                  <widget class="QCheckBox" name="checkBox_Checkpoint">
                   <property name="text">
                    <string>Write checkpoint (enables warm restart)</string>
                   </property>
                   <property name="checked">
                    <bool>true</bool>
                   </property>
                   <property name="toolTip">
                    <string>CHECKPOINT_FILE — writes checkpoint.bin in the output directory: the path set, link travel times. A later run can resume from it instead of starting over.</string>
                   </property>
                  </widget>
                 </item>
                 <item row="0" column="2">
                  <widget class="QLabel" name="label_CkptEvery">
                   <property name="text">
                    <string>Checkpoint every</string>
                   </property>
                  </widget>
                 </item>
                 <item row="0" column="3">
                  <widget class="QLineEdit" name="lineEdit_CheckpointEvery">
                   <property name="maximumSize">
                    <size>
                     <width>80</width>
                     <height>16777215</height>
                    </size>
                   </property>
                   <property name="text">
                    <string>3</string>
                   </property>
                   <property name="toolTip">
                    <string>CHECKPOINT_EVERY — write the checkpoint every N iterations. It is also written on convergence, at the last iteration and on a graceful stop.</string>
                   </property>
                  </widget>
                 </item>
                </layout>
               </widget>
              </item>
              <item>
               <widget class="QGroupBox" name="groupBox_CkptResume">
                <property name="title">
                 <string>Resume</string>
                </property>
                <layout class="QGridLayout" name="gridLayout_ckptr" columnstretch="0,1,0,0">
                 <item row="0" column="0" colspan="4">
                  <widget class="QCheckBox" name="checkBox_Resume">
                   <property name="text">
                    <string>Resume from a checkpoint</string>
                   </property>
                   <property name="toolTip">
                    <string>RESUME_FROM — load this checkpoint and continue from its iteration + 1 instead of starting from free flow. The network must have the same links and the trip list the same route keys (attribute edits such as capacity or toll changes are fine: the affected trips re-route). Sampling is skipped on resume.</string>
                   </property>
                  </widget>
                 </item>
                 <item row="1" column="0">
                  <widget class="QLabel" name="label_ResumeFile">
                   <property name="text">
                    <string>Checkpoint file</string>
                   </property>
                  </widget>
                 </item>
                 <item row="1" column="1" colspan="2">
                  <widget class="QLineEdit" name="lineEdit_ResumeFile">
                   <property name="placeholderText">
                    <string>checkpoint.bin from an earlier run</string>
                   </property>
                  </widget>
                 </item>
                 <item row="1" column="3">
                  <widget class="QPushButton" name="browse_ResumeFile">
                   <property name="maximumSize">
                    <size>
                     <width>40</width>
                     <height>16777215</height>
                    </size>
                   </property>
                   <property name="text">
                    <string>...</string>
                   </property>
                  </widget>
                 </item>
                 <item row="2" column="0" colspan="4">
                  <widget class="QLabel" name="label_ResumeInfo">
                   <property name="text">
                    <string/>
                   </property>
                   <property name="wordWrap">
                    <bool>true</bool>
                   </property>
                  </widget>
                 </item>
                 <item row="3" column="0">
                  <widget class="QLabel" name="label_ResumeMode">
                   <property name="text">
                    <string>Then run</string>
                   </property>
                  </widget>
                 </item>
                 <item row="3" column="1">
                  <widget class="QComboBox" name="comboBox_ResumeMode">
                   <item>
                    <property name="text">
                     <string>Up to Max Iterations</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>N more iterations</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>Outputs only (no new iterations)</string>
                    </property>
                   </item>
                  </widget>
                 </item>
                 <item row="3" column="2">
                  <widget class="QLabel" name="label_ResumeMore">
                   <property name="text">
                    <string>N</string>
                   </property>
                   <property name="alignment">
                    <set>Qt::AlignRight|Qt::AlignVCenter</set>
                   </property>
                  </widget>
                 </item>
                 <item row="3" column="3">
                  <widget class="QLineEdit" name="lineEdit_ResumeMore">
                   <property name="maximumSize">
                    <size>
                     <width>80</width>
                     <height>16777215</height>
                    </size>
                   </property>
                   <property name="text">
                    <string>3</string>
                   </property>
                  </widget>
                 </item>
                </layout>
               </widget>
              </item>
              <item>
               <spacer name="page_DTA_CheckpointSpacer">
                <property name="orientation">
                 <enum>Qt::Vertical</enum>
                </property>
                <property name="sizeHint" stdset="0">
                 <size>
                  <width>20</width>
                  <height>5</height>
                 </size>
                </property>
               </spacer>
              </item>
             </layout>
            </widget>
            <widget class="QWidget" name="page_DTA_Odme">
             <attribute name="title">
              <string>Counts / ODME</string>
             </attribute>
             <layout class="QVBoxLayout" name="page_DTA_OdmeLayout">
              <item>
               <widget class="QGroupBox" name="groupBox_Odme">
                <property name="title">
                 <string>Counts and demand adjustment (ODME)</string>
                </property>
                <layout class="QGridLayout" name="gridLayout_odme">
                 <item row="0" column="0">
                  <widget class="QLabel" name="label_countFile">
                   <property name="text">
                    <string>Count file</string>
                   </property>
                  </widget>
                 </item>
                 <item row="0" column="1" colspan="2">
                  <widget class="QLineEdit" name="lineEdit_CountFile">
                   <property name="placeholderText">
                    <string>(blank = no time-windowed validation, no ODME)</string>
                   </property>
                   <property name="toolTip">
                    <string>TIME_COUNT_FILE — ELToD time-sliced counts: A,B,StartTime,EndTime,Count,Importance (HH:MM:SS, vehicles). Always writes count_windows.csv; also the target for ODME.</string>
                   </property>
                  </widget>
                 </item>
                 <item row="0" column="3">
                  <widget class="QPushButton" name="browse_CountFile">
                   <property name="text">
                    <string>...</string>
                   </property>
                  </widget>
                 </item>
                 <item row="1" column="0" colspan="2">
                  <widget class="QCheckBox" name="checkBox_Odme">
                   <property name="text">
                    <string>Adjust demand to the counts (ODME)</string>
                   </property>
                   <property name="toolTip">
                    <string>ODME — after the assignment converges, scale route-key demand toward the counts, re-assigning warm between rounds. Every output then reflects the adjusted demand; count_windows_pre_odme.csv keeps the unadjusted fit.</string>
                   </property>
                  </widget>
                 </item>
                 <item row="1" column="2">
                  <widget class="QLabel" name="label_odmeMode">
                   <property name="text">
                    <string>Mode</string>
                   </property>
                  </widget>
                 </item>
                 <item row="1" column="3">
                  <widget class="QComboBox" name="comboBox_OdmeMode">
                   <property name="toolTip">
                    <string>ODME_MODE — Grow only: raise under-loaded routes only; the added trips are the unmodeled (missing) market, written to odme_supplement.csv. Grow and reduce: also lowers over-loaded routes (reductions are reported in od_adjustment.csv, never in the supplement).</string>
                   </property>
                   <item>
                    <property name="text">
                     <string>Grow only (missing market)</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>Grow and reduce</string>
                    </property>
                   </item>
                  </widget>
                 </item>
                 <item row="2" column="0">
                  <widget class="QLabel" name="label_odmeRounds">
                   <property name="text">
                    <string>Rounds</string>
                   </property>
                  </widget>
                 </item>
                 <item row="2" column="1">
                  <widget class="QLineEdit" name="lineEdit_OdmeRounds">
                   <property name="text">
                    <string>2</string>
                   </property>
                   <property name="toolTip">
                    <string>ODME_ROUNDS — weight-update rounds; each ends with a warm re-assignment so routes and congestion respond to the new demand.</string>
                   </property>
                  </widget>
                 </item>
                 <item row="2" column="2">
                  <widget class="QLabel" name="label_odmeReassign">
                   <property name="text">
                    <string>Re-assign iterations</string>
                   </property>
                  </widget>
                 </item>
                 <item row="2" column="3">
                  <widget class="QLineEdit" name="lineEdit_OdmeReassign">
                   <property name="text">
                    <string>3</string>
                   </property>
                   <property name="toolTip">
                    <string>ODME_REASSIGN_ITERS — equilibrium iterations per re-assignment (0 = reload the fixed paths through the loader without re-routing).</string>
                   </property>
                  </widget>
                 </item>
                 <item row="3" column="0">
                  <widget class="QLabel" name="label_odmePasses">
                   <property name="text">
                    <string>Passes per round</string>
                   </property>
                  </widget>
                 </item>
                 <item row="3" column="1">
                  <widget class="QLineEdit" name="lineEdit_OdmePasses">
                   <property name="text">
                    <string>5</string>
                   </property>
                   <property name="toolTip">
                    <string>ODME_PASSES — weight-update passes per round on the fixed paths.</string>
                   </property>
                  </widget>
                 </item>
                 <item row="3" column="2">
                  <widget class="QLabel" name="label_odmeAlpha">
                   <property name="text">
                    <string>Damping (alpha)</string>
                   </property>
                  </widget>
                 </item>
                 <item row="3" column="3">
                  <widget class="QLineEdit" name="lineEdit_OdmeAlpha">
                   <property name="text">
                    <string>0.5</string>
                   </property>
                   <property name="toolTip">
                    <string>ODME_ALPHA — exponent on each pass's obs/model factor (1 = full step, smaller = gentler).</string>
                   </property>
                  </widget>
                 </item>
                 <item row="4" column="0">
                  <widget class="QLabel" name="label_odmeMaxStep">
                   <property name="text">
                    <string>Max step per pass</string>
                   </property>
                  </widget>
                 </item>
                 <item row="4" column="1">
                  <widget class="QLineEdit" name="lineEdit_OdmeMaxStep">
                   <property name="text">
                    <string>0.25</string>
                   </property>
                   <property name="toolTip">
                    <string>ODME_MAX_STEP — cap on one pass's change as a fraction (0.25 = ±25%).</string>
                   </property>
                  </widget>
                 </item>
                 <item row="4" column="2">
                  <widget class="QLabel" name="label_odmeBounds">
                   <property name="text">
                    <string>Weight bounds (lo / hi)</string>
                   </property>
                  </widget>
                 </item>
                 <item row="4" column="3">
                  <widget class="QLineEdit" name="lineEdit_OdmeBounds">
                   <property name="text">
                    <string>0.5 / 2.0</string>
                   </property>
                   <property name="toolTip">
                    <string>ODME_BOUND_LO / ODME_BOUND_HI — cumulative factor limits on any route key vs its modeled demand. Grow only forces lo = 1.</string>
                   </property>
                  </widget>
                 </item>
                 <item row="5" column="0">
                  <widget class="QLabel" name="label_odmeMinImp">
                   <property name="text">
                    <string>Min importance</string>
                   </property>
                  </widget>
                 </item>
                 <item row="5" column="1">
                  <widget class="QLineEdit" name="lineEdit_OdmeMinImportance">
                   <property name="text">
                    <string>0</string>
                   </property>
                   <property name="toolTip">
                    <string>ODME_MIN_IMPORTANCE — ignore count windows whose Importance is below this.</string>
                   </property>
                  </widget>
                 </item>
                 <item row="5" column="2">
                  <widget class="QLabel" name="label_odmeClip">
                   <property name="text">
                    <string>Min model vol / ratio clip</string>
                   </property>
                  </widget>
                 </item>
                 <item row="5" column="3">
                  <widget class="QLineEdit" name="lineEdit_OdmeModelClip">
                   <property name="text">
                    <string>1 / 10</string>
                   </property>
                   <property name="toolTip">
                    <string>ODME_MIN_MODEL / ODME_RATIO_CLIP — skip windows with model volume below the first value; clip each window's obs/model to [1/clip, clip].</string>
                   </property>
                  </widget>
                 </item>
                </layout>
               </widget>
              </item>
              <item>
               <widget class="QGroupBox" name="groupBox_Supplement">
                <property name="title">
                 <string>Supplemental demand (unmodeled market, e.g. a prior odme_supplement.csv)</string>
                </property>
                <layout class="QGridLayout" name="gridLayout_supp">
                 <item row="0" column="0">
                  <widget class="QLabel" name="label_suppFile">
                   <property name="text">
                    <string>Supplement trips</string>
                   </property>
                  </widget>
                 </item>
                 <item row="0" column="1" colspan="2">
                  <widget class="QLineEdit" name="lineEdit_SuppFile">
                   <property name="placeholderText">
                    <string>(blank = none)</string>
                   </property>
                   <property name="toolTip">
                    <string>SUPPLEMENT_TRIP_FILE — appended after the trip list and tagged market ODME. Do not combine with ODME on the run that created it unless you want a cumulative re-estimate.</string>
                   </property>
                  </widget>
                 </item>
                 <item row="0" column="3">
                  <widget class="QPushButton" name="browse_SuppFile">
                   <property name="text">
                    <string>...</string>
                   </property>
                  </widget>
                 </item>
                 <item row="1" column="0">
                  <widget class="QLabel" name="label_suppScale">
                   <property name="text">
                    <string>Scale</string>
                   </property>
                  </widget>
                 </item>
                 <item row="1" column="1">
                  <widget class="QLineEdit" name="lineEdit_SuppScale">
                   <property name="text">
                    <string>1.0</string>
                   </property>
                   <property name="toolTip">
                    <string>SUPPLEMENT_SCALE — flat factor on every supplement trip (future-year growth of the unmodeled market).</string>
                   </property>
                  </widget>
                 </item>
                 <item row="2" column="0">
                  <widget class="QLabel" name="label_suppGrowth">
                   <property name="text">
                    <string>Zonal growth file</string>
                   </property>
                  </widget>
                 </item>
                 <item row="2" column="1" colspan="2">
                  <widget class="QLineEdit" name="lineEdit_SuppGrowth">
                   <property name="placeholderText">
                    <string>(blank = flat scale only)</string>
                   </property>
                   <property name="toolTip">
                    <string>SUPPLEMENT_GROWTH_FILE — zone,factor CSV (zone = O/D centroid id). Each supplement trip O→D is multiplied by sqrt(g_O × g_D); zones not listed grow 1.0.</string>
                   </property>
                  </widget>
                 </item>
                 <item row="2" column="3">
                  <widget class="QPushButton" name="browse_SuppGrowth">
                   <property name="text">
                    <string>...</string>
                   </property>
                  </widget>
                 </item>
                </layout>
               </widget>
              </item>
              <item>
               <spacer name="page_DTA_OdmeSpacer">
                <property name="orientation">
                 <enum>Qt::Vertical</enum>
                </property>
                <property name="sizeHint" stdset="0">
                 <size>
                  <width>20</width>
                  <height>5</height>
                 </size>
                </property>
               </spacer>
              </item>
             </layout>
            </widget>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="groupBox_Outputs">
            <property name="title">
             <string>Outputs (link performance by macro/meso/micro is always written)</string>
            </property>
            <layout class="QGridLayout" name="gridLayout_out">
             <item row="0" column="0">
              <widget class="QCheckBox" name="checkBox_AgentPlans">
               <property name="toolTip">
                <string>Light per-agent summary (agentPlans_out.csv). Uncheck to skip.</string>
               </property>
               <property name="text">
                <string>Agent plans (agentPlans_out.csv)</string>
               </property>
               <property name="checked">
                <bool>true</bool>
               </property>
              </widget>
             </item>
             <item row="0" column="1">
              <widget class="QCheckBox" name="checkBox_AgentPaths">
               <property name="toolTip">
                <string>Full per-agent paths (agentPaths.duckdb, large). Feeds agentAnalysis select-link / trace / tiers. Uncheck to skip.</string>
               </property>
               <property name="text">
                <string>Agent paths (agentPaths.duckdb, heavy)</string>
               </property>
               <property name="checked">
                <bool>true</bool>
               </property>
              </widget>
             </item>
             <item row="2" column="0" colspan="2">
              <layout class="QHBoxLayout" name="hLayout_breakdowns">
               <item>
                <widget class="QLabel" name="label_breakdowns">
                 <property name="text">
                  <string>Extra volume breakdowns:</string>
                 </property>
                 <property name="toolTip">
                  <string>Purpose is always in the link performance files. Each ticked breakdown is written to its own link_volume_by_&lt;kind&gt;.csv (one row per link x 15 min, columns sum to the volume) for the Summarization Link Performance tab. Each adds a file about the size of the link performance file.</string>
                 </property>
                </widget>
               </item>
               <item>
                <widget class="QCheckBox" name="checkBox_BdMarket">
                 <property name="text">
                  <string>Market</string>
                 </property>
                </widget>
               </item>
               <item>
                <widget class="QCheckBox" name="checkBox_BdSegment">
                 <property name="text">
                  <string>Market x VOT</string>
                 </property>
                </widget>
               </item>
               <item>
                <widget class="QCheckBox" name="checkBox_BdVotBin">
                 <property name="text">
                  <string>VOT bins</string>
                 </property>
                </widget>
               </item>
               <item>
                <widget class="QLineEdit" name="lineEdit_VotEdges">
                 <property name="text">
                  <string>10,20,40,80</string>
                 </property>
                 <property name="maximumSize">
                  <size>
                   <width>110</width>
                   <height>16777215</height>
                  </size>
                 </property>
                 <property name="toolTip">
                  <string>VOT_BIN_EDGES - bin edges in $/hr (&lt;10, 10-20, 20-40, 40-80, 80+).</string>
                 </property>
                </widget>
               </item>
              </layout>
             </item>
             <item row="1" column="0" colspan="2">
              <widget class="QCheckBox" name="checkBox_BuildViz">
               <property name="text">
                <string>Build visualizer layers after the run (meso segments, micro lanes, intersection LOS)</string>
               </property>
               <property name="toolTip">
                <string>Runs the Visualizer builder on this run: Meso Segments (needs the Segment log) and Micro Lanes (needs a freeway micro corridor), AM + PM peak hours at 15 min, and for a network micro run Micro movement LOS and Micro intersection LOS on the GMNS geometry (visualizer/micro_los.gpkg), added to the map.</string>
               </property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>
         </layout>
        </widget>
        <widget class="QWidget" name="page_STA">
         <attribute name="title">
          <string>STA (static)</string>
         </attribute>
         <layout class="QVBoxLayout" name="staLayout">
          <item>
           <widget class="QTabWidget" name="tabWidget_STA">
            <property name="currentIndex">
             <number>0</number>
            </property>
            <widget class="QWidget" name="page_STA_Solver">
             <attribute name="title">
              <string>Solver and VDF</string>
             </attribute>
             <layout class="QVBoxLayout" name="page_STA_SolverLayout">
              <item>
               <widget class="QGroupBox" name="groupBox_StaModel">
                <property name="title">
                 <string>Static assignment (MACRO_MODEL = STA_BPR)</string>
                </property>
                <layout class="QGridLayout" name="gridLayout_stamodel">
                 <item row="0" column="0" rowspan="1" colspan="1">
                  <widget class="QLabel" name="label_staSolver">
                   <property name="text">
                    <string>Solver</string>
                   </property>
                  </widget>
                 </item>
                 <item row="0" column="1" rowspan="1" colspan="3">
                  <widget class="QComboBox" name="comboBox_StaMethod">
                   <property name="toolTip">
                    <string>All-or-nothing plus a step on the Beckmann objective. The conjugate variants remove Frank-Wolfe's zigzag near the optimum; legacy is the old DTA path-swap loop, which cannot converge a static assignment.</string>
                   </property>
                   <property name="currentIndex">
                    <number>-1</number>
                   </property>
                   <item>
                    <property name="text">
                     <string>Bi-conjugate Frank-Wolfe (fastest)</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>Conjugate Frank-Wolfe</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>Frank-Wolfe</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>MSA (step 1/k)</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>Legacy path-swap (does not converge)</string>
                    </property>
                   </item>
                  </widget>
                 </item>
                 <item row="2" column="0" rowspan="1" colspan="1">
                  <widget class="QLabel" name="label_bprPeriod">
                   <property name="text">
                    <string>VDF period</string>
                   </property>
                  </widget>
                 </item>
                 <item row="2" column="1" rowspan="1" colspan="1">
                  <widget class="QComboBox" name="comboBox_BprPeriod">
                   <property name="toolTip">
                    <string>Minutes the BPR curve aggregates over before pricing v/c. Volumes are still reported per 15 minutes; only travel time is held constant across the window.</string>
                   </property>
                   <property name="currentIndex">
                    <number>2</number>
                   </property>
                   <item>
                    <property name="text">
                     <string>15 min</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>30 min</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>60 min (hourly)</string>
                    </property>
                   </item>
                  </widget>
                 </item>
                 <item row="2" column="2" rowspan="1" colspan="2">
                  <widget class="QLabel" name="label_bprCoef">
                   <property name="text">
                    <string>alpha / beta come per-link from the ALPHA / BETA columns</string>
                   </property>
                  </widget>
                 </item>
                 <item row="1" column="0" rowspan="1" colspan="1">
                  <widget class="QLabel" name="label_staVdf">
                   <property name="text">
                    <string>VDF curve</string>
                   </property>
                  </widget>
                 </item>
                 <item row="1" column="1" rowspan="1" colspan="3">
                  <widget class="QComboBox" name="comboBox_StaVdf">
                   <property name="toolTip">
                    <string>Volume-delay curve for the static assignment.
BPR - the legacy TSM curve; alpha/beta come per-link from the ALPHA/BETA columns.
Conical (Spiess) - smooth and strictly increasing, with a bounded derivative, so the Frank-Wolfe line search behaves better near v/c = 1.
Akcelik - time-dependent queueing form: over-saturated delay grows with how long the link stays over capacity, not with v/c alone.</string>
                   </property>
                   <item>
                    <property name="text">
                     <string>BPR (legacy TSM)</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>Conical (Spiess)</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>Akcelik (time-dependent)</string>
                    </property>
                   </item>
                  </widget>
                 </item>
                 <item row="3" column="0" rowspan="1" colspan="2">
                  <widget class="QCheckBox" name="checkBox_BprOverCap">
                   <property name="text">
                    <string>Steeper beta above capacity (v/c &gt; 1)</string>
                   </property>
                   <property name="toolTip">
                    <string>BPR fitted to under-capacity data understates over-saturated delay. Ticking this multiplies beta -- only where v/c &gt; 1 -- by the factor on the right; below capacity the curve is unchanged. BPR only.</string>
                   </property>
                  </widget>
                 </item>
                 <item row="3" column="2" rowspan="1" colspan="1">
                  <widget class="QLabel" name="label_bprBetaMult">
                   <property name="text">
                    <string>beta multiplier</string>
                   </property>
                  </widget>
                 </item>
                 <item row="3" column="3" rowspan="1" colspan="1">
                  <widget class="QLineEdit" name="lineEdit_BprBetaMult">
                   <property name="text">
                    <string>1.5</string>
                   </property>
                   <property name="toolTip">
                    <string>Factor applied to beta above capacity (&gt;= 1). 1.0 is the legacy single exponent. Note the BPR tail is already steep: large values drive over-saturated links toward the 1440-minute delay clamp.</string>
                   </property>
                  </widget>
                 </item>
                 <item row="4" column="0" rowspan="1" colspan="1">
                  <widget class="QLabel" name="label_conicalAlpha">
                   <property name="text">
                    <string>Conical alpha</string>
                   </property>
                  </widget>
                 </item>
                 <item row="4" column="1" rowspan="1" colspan="1">
                  <widget class="QLineEdit" name="lineEdit_ConicalAlpha">
                   <property name="text">
                    <string>4.0</string>
                   </property>
                   <property name="toolTip">
                    <string>Spiess conical parameter a, must be &gt; 1. Larger a hugs the capacity asymptote more tightly; 4 is close to BPR alpha=0.15 beta=4.</string>
                   </property>
                  </widget>
                 </item>
                 <item row="4" column="2" rowspan="1" colspan="1">
                  <widget class="QLabel" name="label_akcelikJa">
                   <property name="text">
                    <string>Akcelik J_A</string>
                   </property>
                  </widget>
                 </item>
                 <item row="4" column="3" rowspan="1" colspan="1">
                  <widget class="QLineEdit" name="lineEdit_AkcelikJa">
                   <property name="text">
                    <string>0.1</string>
                   </property>
                   <property name="toolTip">
                    <string>Akcelik delay parameter. About 0.1 for freeways, 0.4 for arterials.</string>
                   </property>
                  </widget>
                 </item>
                </layout>
               </widget>
              </item>
              <item>
               <spacer name="page_STA_SolverSpacer">
                <property name="orientation">
                 <enum>Qt::Vertical</enum>
                </property>
                <property name="sizeHint" stdset="0">
                 <size>
                  <width>20</width>
                  <height>5</height>
                 </size>
                </property>
               </spacer>
              </item>
             </layout>
            </widget>
            <widget class="QWidget" name="page_STA_Equil">
             <attribute name="title">
              <string>Equilibrium</string>
             </attribute>
             <layout class="QVBoxLayout" name="page_STA_EquilLayout">
              <item>
               <widget class="QGroupBox" name="groupBox_StaEquil">
                <property name="title">
                 <string>Equilibrium</string>
                </property>
                <layout class="QGridLayout" name="gridLayout_staeq">
                 <item row="0" column="0" rowspan="1" colspan="1">
                  <widget class="QLabel" name="label_staIters">
                   <property name="text">
                    <string>Max Iterations</string>
                   </property>
                  </widget>
                 </item>
                 <item row="0" column="1" rowspan="1" colspan="1">
                  <widget class="QLineEdit" name="lineEdit_StaIters">
                   <property name="text">
                    <string>15</string>
                   </property>
                  </widget>
                 </item>
                 <item row="0" column="2" rowspan="1" colspan="1">
                  <widget class="QLabel" name="label_staGap">
                   <property name="text">
                    <string>Relative Gap</string>
                   </property>
                  </widget>
                 </item>
                 <item row="0" column="3" rowspan="1" colspan="1">
                  <widget class="QLineEdit" name="lineEdit_StaGap">
                   <property name="text">
                    <string>0.01</string>
                   </property>
                  </widget>
                 </item>
                 <item row="1" column="0" rowspan="1" colspan="1">
                  <widget class="QLabel" name="label_staThreads">
                   <property name="text">
                    <string>Threads (0=all)</string>
                   </property>
                  </widget>
                 </item>
                 <item row="1" column="1" rowspan="1" colspan="1">
                  <widget class="QLineEdit" name="lineEdit_StaThreads">
                   <property name="text">
                    <string>0</string>
                   </property>
                  </widget>
                 </item>
                </layout>
               </widget>
              </item>
              <item>
               <spacer name="page_STA_EquilSpacer">
                <property name="orientation">
                 <enum>Qt::Vertical</enum>
                </property>
                <property name="sizeHint" stdset="0">
                 <size>
                  <width>20</width>
                  <height>5</height>
                 </size>
                </property>
               </spacer>
              </item>
             </layout>
            </widget>
            <widget class="QWidget" name="page_STA_Demand">
             <attribute name="title">
              <string>Demand</string>
             </attribute>
             <layout class="QVBoxLayout" name="page_STA_DemandLayout">
              <item>
               <widget class="QGroupBox" name="groupBox_StaDemand">
                <property name="title">
                 <string>Demand</string>
                </property>
                <layout class="QGridLayout" name="gridLayout_stadem">
                 <item row="0" column="0" rowspan="1" colspan="1">
                  <widget class="QLabel" name="label_staMaxTrips">
                   <property name="text">
                    <string>Max trips (0=all)</string>
                   </property>
                  </widget>
                 </item>
                 <item row="0" column="1" rowspan="1" colspan="1">
                  <widget class="QLineEdit" name="lineEdit_StaMaxTrips">
                   <property name="text">
                    <string>0</string>
                   </property>
                  </widget>
                 </item>
                 <item row="0" column="2" rowspan="1" colspan="1">
                  <widget class="QLabel" name="label_staSample">
                   <property name="text">
                    <string>Sample every</string>
                   </property>
                  </widget>
                 </item>
                 <item row="0" column="3" rowspan="1" colspan="1">
                  <widget class="QLineEdit" name="lineEdit_StaSampleEvery">
                   <property name="text">
                    <string>1</string>
                   </property>
                  </widget>
                 </item>
                 <item row="1" column="0" rowspan="1" colspan="1">
                  <widget class="QLabel" name="label_staSampleSched">
                   <property name="text">
                    <string>Sampling schedule</string>
                   </property>
                  </widget>
                 </item>
                 <item row="1" column="1" rowspan="1" colspan="1">
                  <widget class="QComboBox" name="comboBox_StaSampleSchedule">
                   <property name="currentIndex">
                    <number>0</number>
                   </property>
                   <item>
                    <property name="text">
                     <string>None (full demand)</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>Progressive (25 -&gt; 50 -&gt; 100%)</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>Custom</string>
                    </property>
                   </item>
                  </widget>
                 </item>
                 <item row="1" column="2" rowspan="1" colspan="1">
                  <widget class="QLabel" name="label_staSampleCustom">
                   <property name="text">
                    <string>Custom schedule</string>
                   </property>
                  </widget>
                 </item>
                 <item row="1" column="3" rowspan="1" colspan="1">
                  <widget class="QLineEdit" name="lineEdit_StaSampleSchedule">
                   <property name="placeholderText">
                    <string>1-4:25, 5-8:50...</string>
                   </property>
                  </widget>
                 </item>
                </layout>
               </widget>
              </item>
              <item>
               <spacer name="page_STA_DemandSpacer">
                <property name="orientation">
                 <enum>Qt::Vertical</enum>
                </property>
                <property name="sizeHint" stdset="0">
                 <size>
                  <width>20</width>
                  <height>5</height>
                 </size>
                </property>
               </spacer>
              </item>
             </layout>
            </widget>
            <widget class="QWidget" name="page_STA_Checkpoint">
             <attribute name="title">
              <string>Checkpoint</string>
             </attribute>
             <layout class="QVBoxLayout" name="page_STA_CheckpointLayout">
              <item>
               <widget class="QGroupBox" name="groupBox_StaCkptWrite">
                <property name="title">
                 <string>Write</string>
                </property>
                <layout class="QGridLayout" name="gridLayout_stackptw" columnstretch="0,0,0,1">
                 <item row="0" column="0" colspan="2">
                  <widget class="QCheckBox" name="checkBox_StaCheckpoint">
                   <property name="text">
                    <string>Write checkpoint (enables warm restart)</string>
                   </property>
                   <property name="checked">
                    <bool>true</bool>
                   </property>
                   <property name="toolTip">
                    <string>CHECKPOINT_FILE — writes checkpoint.bin in the output directory: the path set, link travel times and the averaged link flow (the STA state). A later run can resume from it instead of starting over.</string>
                   </property>
                  </widget>
                 </item>
                 <item row="0" column="2">
                  <widget class="QLabel" name="label_staCkptEvery">
                   <property name="text">
                    <string>Checkpoint every</string>
                   </property>
                  </widget>
                 </item>
                 <item row="0" column="3">
                  <widget class="QLineEdit" name="lineEdit_StaCheckpointEvery">
                   <property name="maximumSize">
                    <size>
                     <width>80</width>
                     <height>16777215</height>
                    </size>
                   </property>
                   <property name="text">
                    <string>3</string>
                   </property>
                   <property name="toolTip">
                    <string>CHECKPOINT_EVERY — write the checkpoint every N iterations. It is also written on convergence, at the last iteration and on a graceful stop.</string>
                   </property>
                  </widget>
                 </item>
                </layout>
               </widget>
              </item>
              <item>
               <widget class="QGroupBox" name="groupBox_StaCkptResume">
                <property name="title">
                 <string>Resume</string>
                </property>
                <layout class="QGridLayout" name="gridLayout_stackptr" columnstretch="0,1,0,0">
                 <item row="0" column="0" colspan="4">
                  <widget class="QCheckBox" name="checkBox_StaResume">
                   <property name="text">
                    <string>Resume from a checkpoint</string>
                   </property>
                   <property name="toolTip">
                    <string>RESUME_FROM — load this checkpoint and continue from its iteration + 1 instead of starting from free flow. The network must have the same links and the trip list the same route keys (attribute edits such as capacity or toll changes are fine: the affected trips re-route). Sampling is skipped on resume. STA resumes only from an STA checkpoint (it needs the averaged link flow).</string>
                   </property>
                  </widget>
                 </item>
                 <item row="1" column="0">
                  <widget class="QLabel" name="label_staResumeFile">
                   <property name="text">
                    <string>Checkpoint file</string>
                   </property>
                  </widget>
                 </item>
                 <item row="1" column="1" colspan="2">
                  <widget class="QLineEdit" name="lineEdit_StaResumeFile">
                   <property name="placeholderText">
                    <string>checkpoint.bin from an earlier run</string>
                   </property>
                  </widget>
                 </item>
                 <item row="1" column="3">
                  <widget class="QPushButton" name="browse_StaResumeFile">
                   <property name="maximumSize">
                    <size>
                     <width>40</width>
                     <height>16777215</height>
                    </size>
                   </property>
                   <property name="text">
                    <string>...</string>
                   </property>
                  </widget>
                 </item>
                 <item row="2" column="0" colspan="4">
                  <widget class="QLabel" name="label_StaResumeInfo">
                   <property name="text">
                    <string/>
                   </property>
                   <property name="wordWrap">
                    <bool>true</bool>
                   </property>
                  </widget>
                 </item>
                 <item row="3" column="0">
                  <widget class="QLabel" name="label_staResumeMode">
                   <property name="text">
                    <string>Then run</string>
                   </property>
                  </widget>
                 </item>
                 <item row="3" column="1">
                  <widget class="QComboBox" name="comboBox_StaResumeMode">
                   <item>
                    <property name="text">
                     <string>Up to Max Iterations</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>N more iterations</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>Outputs only (no new iterations)</string>
                    </property>
                   </item>
                  </widget>
                 </item>
                 <item row="3" column="2">
                  <widget class="QLabel" name="label_staResumeMore">
                   <property name="text">
                    <string>N</string>
                   </property>
                   <property name="alignment">
                    <set>Qt::AlignRight|Qt::AlignVCenter</set>
                   </property>
                  </widget>
                 </item>
                 <item row="3" column="3">
                  <widget class="QLineEdit" name="lineEdit_StaResumeMore">
                   <property name="maximumSize">
                    <size>
                     <width>80</width>
                     <height>16777215</height>
                    </size>
                   </property>
                   <property name="text">
                    <string>3</string>
                   </property>
                  </widget>
                 </item>
                </layout>
               </widget>
              </item>
              <item>
               <spacer name="page_STA_CheckpointSpacer">
                <property name="orientation">
                 <enum>Qt::Vertical</enum>
                </property>
                <property name="sizeHint" stdset="0">
                 <size>
                  <width>20</width>
                  <height>5</height>
                 </size>
                </property>
               </spacer>
              </item>
             </layout>
            </widget>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="groupBox_StaOutputs">
            <property name="title">
             <string>Outputs (link performance is always written)</string>
            </property>
            <layout class="QGridLayout" name="gridLayout_staout">
             <item row="0" column="0" rowspan="1" colspan="1">
              <widget class="QCheckBox" name="checkBox_StaAgentPlans">
               <property name="text">
                <string>Agent plans (agentPlans_out.csv)</string>
               </property>
               <property name="checked">
                <bool>true</bool>
               </property>
              </widget>
             </item>
             <item row="0" column="1" rowspan="1" colspan="1">
              <widget class="QCheckBox" name="checkBox_StaAgentPaths">
               <property name="text">
                <string>Agent paths (agentPaths.duckdb, heavy)</string>
               </property>
              </widget>
             </item>
             <item row="1" column="0" rowspan="1" colspan="2">
              <widget class="QCheckBox" name="checkBox_StaPathScale">
               <property name="text">
                <string>Path-flow reconciliation (sta_path_scale.csv)</string>
               </property>
               <property name="checked">
                <bool>true</bool>
               </property>
               <property name="toolTip">
                <string>Per-link factor between the equilibrium volume and the volume implied by the written agent paths. Multiply a path-derived result (select-link, subarea, trace) by it to put it on the same footing as the reported volume.</string>
               </property>
              </widget>
             </item>
             <item row="2" column="0" rowspan="1" colspan="2">
              <widget class="QLabel" name="label_staPathWarn">
               <property name="text">
                <string>Note: a Frank-Wolfe flow is an average of all-or-nothing solutions, so agent paths are the LAST all-or-nothing and do not re-sum to the link volumes. Link volumes are the equilibrium.</string>
               </property>
               <property name="wordWrap">
                <bool>true</bool>
               </property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>
         </layout>
        </widget>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout" name="runLayout">
        <item>
         <widget class="QPushButton" name="run_Hydra">
          <property name="text">
           <string>Run</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QDialogButtonBox" name="buttonBox">
          <property name="standardButtons">
           <set>QDialogButtonBox::Cancel|QDialogButtonBox::Save</set>
          </property>
         </widget>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QTextBrowser" name="textBrowser">
     <property name="minimumSize">
      <size>
       <width>320</width>
       <height>0</height>
      </size>
     </property>
     <property name="openExternalLinks">
      <bool>true</bool>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
