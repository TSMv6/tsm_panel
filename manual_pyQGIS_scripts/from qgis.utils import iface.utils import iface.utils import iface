# Get screen cooridnates
from qgis.gui import QgsMapTool
from qgis.core import QgsPointXY

class MouseCoordinatesTool(QgsMapTool):
    def __init__(self, canvas):
        self.canvas = canvas
        QgsMapTool.__init__(self, self.canvas)

    def canvasMoveEvent(self, event):
        #Get mouse position in pixel coordinates
        screen_point = event.pos()
        #Transform screen coordinates to map coordinates
        map_point = self.canvas.getCoordinateTransform().toMapCoordinates(screen_point)
        print(f"Mouse coordinates: Screen - X: {screen_point.x()}, Y: {screen_point.y()} | Map - X: {map_point.x()}, Y: {map_point.y()}")

    def deactivate(self):
        super().deactivate()
        print("Tool deactivated")


# Get the active map canvas
canvas = iface.mapCanvas()

# Create and activate the tool
mouse_tool = MouseCoordinatesTool(canvas)
canvas.setMapTool(mouse_tool)

mouse_tool.deactivate()


